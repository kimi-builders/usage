{
  "name": "@kimi.builders/usage",
  "version": "0.5.2",
  "description": "Local-first usage analytics and optional sync for AI coding agents",
  "type": "module",
  "scripts": {
    "setup": "npm --prefix dashboard install --no-audit --no-fund",
    "dev": "node dashboard/scripts/dev.mjs",
    "test": "node --test",
    "test:collector": "node scripts/test-collector.mjs",
    "test:providers": "node --test test/provider-contract.test.js test/limits-http.test.js",
    "dashboard": "node bin/kbu-usage.js dashboard",
    "dashboard:dev": "node dashboard/scripts/dev.mjs",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:test": "npm --prefix dashboard run test:sites",
    "check:markdown": "node scripts/check-markdown-links.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "release:check": "npm run test:collector && npm run dashboard:build && npm run dashboard:test && npm run check:markdown && npm run audit:package",
    "prepublishOnly": "npm run release:check"
  },
  "bin": {
    "kbu-usage": "bin/kbu-usage.js"
  },
  "files": [
    "bin/",
    "src/",
    "dashboard/dist/client/",
    "docs/",
    "!docs/design-qa.md",
    "PRIVACY.md",
    "PRIVACY.zh.md",
    "NETWORK.md",
    "NETWORK.zh.md",
    "THREAT_MODEL.md",
    "THREAT_MODEL.zh.md",
    "SECURITY.md",
    "SECURITY.zh.md",
    "PUBLISHING.md",
    "PUBLISHING.zh.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "SUPPORT.md",
    "SUPPORT.en.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "kimi",
    "kimi-code",
    "claude-code",
    "codex",
    "ai-coding-agent",
    "local-first",
    "usage",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimi-builders/usage.git"
  },
  "homepage": "https://kimi.builders/usage",
  "license": "MIT"
}
